CREATE TABLE ingredient_product_source (
    id TEXT NOT NULL PRIMARY KEY,
    product_id TEXT NOT NULL REFERENCES ingredient_product(id) ON DELETE CASCADE,
    retrieval_provider TEXT NOT NULL,
    extraction_provider TEXT NOT NULL,
    extraction_model TEXT NOT NULL,
    source_url TEXT NOT NULL,
    field_name TEXT NOT NULL CHECK (field_name IN ('product_name', 'brand', 'quantity', 'abv_percent')),
    field_value TEXT NOT NULL,
    evidence_quote TEXT NOT NULL,
    license_name TEXT,
    created_at INTEGER NOT NULL
);

CREATE UNIQUE INDEX product_source_identity ON ingredient_product_source(
    product_id, retrieval_provider, extraction_provider, extraction_model, source_url, field_name, field_value
);
CREATE INDEX product_source_product ON ingredient_product_source(product_id, created_at, id);
