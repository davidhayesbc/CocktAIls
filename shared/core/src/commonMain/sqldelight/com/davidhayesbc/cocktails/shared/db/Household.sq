CREATE TABLE household (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    created_at INTEGER NOT NULL
);

CREATE TABLE household_location (
    id TEXT NOT NULL PRIMARY KEY,
    household_id TEXT NOT NULL REFERENCES household(id),
    name TEXT NOT NULL,
    created_at INTEGER NOT NULL
);

CREATE TABLE local_preference (
    preference_key TEXT NOT NULL PRIMARY KEY,
    preference_value TEXT NOT NULL
);

CREATE TABLE record_revision (
    id TEXT NOT NULL PRIMARY KEY,
    record_id TEXT NOT NULL,
    record_type TEXT NOT NULL,
    author_member_id TEXT NOT NULL REFERENCES household_member(id),
    device_id TEXT NOT NULL,
    created_at INTEGER NOT NULL,
    schema_version INTEGER NOT NULL DEFAULT 1,
    payload TEXT NOT NULL
);

CREATE TABLE revision_parent (
    revision_id TEXT NOT NULL REFERENCES record_revision(id),
    parent_revision_id TEXT NOT NULL,
    PRIMARY KEY(revision_id, parent_revision_id)
);

CREATE TABLE tombstone (
    record_id TEXT NOT NULL PRIMARY KEY,
    record_type TEXT NOT NULL,
    revision_id TEXT NOT NULL REFERENCES record_revision(id),
    deleted_at INTEGER NOT NULL
);

CREATE TABLE household_member (
    id TEXT NOT NULL PRIMARY KEY,
    household_id TEXT NOT NULL REFERENCES household(id),
    display_name TEXT NOT NULL,
    created_at INTEGER NOT NULL
);

CREATE TABLE ingredient (
    id TEXT NOT NULL PRIMARY KEY,
    canonical_name TEXT NOT NULL,
    category TEXT NOT NULL,
    created_at INTEGER NOT NULL
);

CREATE TABLE ingredient_product (
    id TEXT NOT NULL PRIMARY KEY,
    ingredient_id TEXT NOT NULL REFERENCES ingredient(id),
    brand TEXT,
    product_name TEXT NOT NULL,
    barcode TEXT,
    photo_mime_type TEXT,
    photo_data BLOB,
    photo_sha256 TEXT,
    bottle_quantity TEXT,
    abv_percent TEXT,
    created_at INTEGER NOT NULL
);

CREATE UNIQUE INDEX ingredient_product_barcode ON ingredient_product(barcode) WHERE barcode IS NOT NULL;

CREATE TABLE ingredient_product_source (
    id TEXT NOT NULL PRIMARY KEY,
    product_id TEXT NOT NULL REFERENCES ingredient_product(id) ON DELETE CASCADE,
    retrieval_provider TEXT NOT NULL,
    extraction_provider TEXT NOT NULL,
    extraction_model TEXT NOT NULL,
    source_url TEXT NOT NULL,
    field_name TEXT NOT NULL CHECK (field_name IN ('product_name', 'brand', 'quantity', 'abv_percent')),
    field_value TEXT NOT NULL,
    evidence_quote TEXT NOT NULL,
    license_name TEXT,
    created_at INTEGER NOT NULL
);

CREATE UNIQUE INDEX product_source_identity ON ingredient_product_source(
    product_id, retrieval_provider, extraction_provider, extraction_model, source_url, field_name, field_value
);
CREATE INDEX product_source_product ON ingredient_product_source(product_id, created_at, id);

CREATE TABLE inventory_item (
    id TEXT NOT NULL PRIMARY KEY,
    location_id TEXT NOT NULL REFERENCES household_location(id),
    ingredient_id TEXT NOT NULL REFERENCES ingredient(id),
    product_id TEXT REFERENCES ingredient_product(id),
    level TEXT NOT NULL CHECK (level IN ('FULL', 'MOSTLY_FULL', 'HALF', 'LOW', 'OUT')),
    updated_at INTEGER NOT NULL,
    updated_by_member_id TEXT NOT NULL REFERENCES household_member(id)
);

CREATE INDEX inventory_location_ingredient ON inventory_item(location_id, ingredient_id);
CREATE INDEX inventory_product ON inventory_item(product_id);

CREATE TABLE bottle_intake_session (
    id TEXT NOT NULL PRIMARY KEY,
    status TEXT NOT NULL CHECK (status IN ('OPEN', 'CONFIRMED')),
    location_id TEXT NOT NULL REFERENCES household_location(id),
    default_level TEXT NOT NULL CHECK (default_level IN ('FULL', 'MOSTLY_FULL', 'HALF', 'LOW', 'OUT')),
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL,
    confirmed_count INTEGER NOT NULL DEFAULT 0
);

CREATE TABLE bottle_intake_draft (
    id TEXT NOT NULL PRIMARY KEY,
    session_id TEXT NOT NULL REFERENCES bottle_intake_session(id) ON DELETE CASCADE,
    position INTEGER NOT NULL,
    barcode TEXT,
    product_id TEXT REFERENCES ingredient_product(id),
    ingredient_name TEXT NOT NULL,
    category TEXT NOT NULL,
    brand TEXT,
    product_name TEXT,
    photo_data BLOB,
    photo_sha256 TEXT,
    bottle_quantity TEXT,
    abv_percent TEXT,
    bottle_quantity_edited INTEGER NOT NULL DEFAULT 0,
    abv_percent_edited INTEGER NOT NULL DEFAULT 0,
    location_id TEXT NOT NULL REFERENCES household_location(id),
    level TEXT NOT NULL CHECK (level IN ('FULL', 'MOSTLY_FULL', 'HALF', 'LOW', 'OUT')),
    created_at INTEGER NOT NULL,
    UNIQUE(session_id, position)
);

CREATE TABLE bottle_intake_acceptance (
    draft_id TEXT NOT NULL PRIMARY KEY,
    session_id TEXT NOT NULL REFERENCES bottle_intake_session(id) ON DELETE CASCADE,
    inventory_id TEXT NOT NULL REFERENCES inventory_item(id),
    accepted_at INTEGER NOT NULL
);

CREATE INDEX bottle_intake_acceptance_session ON bottle_intake_acceptance(session_id, accepted_at, draft_id);

CREATE INDEX bottle_intake_draft_session ON bottle_intake_draft(session_id, position);

CREATE UNIQUE INDEX ingredient_name_category
ON ingredient(canonical_name COLLATE NOCASE, category COLLATE NOCASE);

CREATE TABLE cocktail_family (
    id TEXT NOT NULL PRIMARY KEY,
    canonical_name TEXT NOT NULL,
    created_at INTEGER NOT NULL
);

CREATE TABLE cocktail_alias (
    family_id TEXT NOT NULL REFERENCES cocktail_family(id),
    alias TEXT NOT NULL,
    PRIMARY KEY(family_id, alias)
);

CREATE TABLE recipe_variant (
    id TEXT NOT NULL PRIMARY KEY,
    family_id TEXT NOT NULL REFERENCES cocktail_family(id),
    title TEXT NOT NULL,
    source_kind TEXT NOT NULL,
    instructions TEXT NOT NULL DEFAULT '',
    preparation TEXT NOT NULL DEFAULT '',
    servings REAL NOT NULL DEFAULT 1,
    style TEXT NOT NULL DEFAULT 'OTHER',
    revision_id TEXT REFERENCES record_revision(id),
    created_at INTEGER NOT NULL
);

CREATE TABLE recipe_source (
    id TEXT NOT NULL PRIMARY KEY,
    variant_id TEXT NOT NULL REFERENCES recipe_variant(id),
    source_name TEXT NOT NULL,
    source_record_id TEXT,
    source_url TEXT,
    license_name TEXT,
    attribution TEXT,
    modifications TEXT,
    imported_at INTEGER NOT NULL
);

CREATE TABLE recipe_ingredient (
    id TEXT NOT NULL PRIMARY KEY,
    variant_id TEXT NOT NULL REFERENCES recipe_variant(id),
    ingredient_id TEXT NOT NULL REFERENCES ingredient(id),
    amount_value REAL,
    amount_unit TEXT,
    preparation TEXT,
    optional INTEGER NOT NULL DEFAULT 0,
    sort_order INTEGER NOT NULL
);

CREATE TABLE tasting_note (
    id TEXT NOT NULL PRIMARY KEY,
    variant_id TEXT NOT NULL REFERENCES recipe_variant(id),
    member_id TEXT NOT NULL REFERENCES household_member(id),
    location_id TEXT REFERENCES household_location(id),
    rating INTEGER CHECK (rating BETWEEN 1 AND 5),
    note TEXT NOT NULL DEFAULT '',
    created_at INTEGER NOT NULL,
    revision_id TEXT REFERENCES record_revision(id)
);

CREATE TABLE favorite (
    member_id TEXT NOT NULL REFERENCES household_member(id),
    family_id TEXT NOT NULL REFERENCES cocktail_family(id),
    created_at INTEGER NOT NULL,
    PRIMARY KEY(member_id, family_id)
);

CREATE TABLE drink_event (
    id TEXT NOT NULL PRIMARY KEY,
    variant_id TEXT NOT NULL REFERENCES recipe_variant(id),
    member_id TEXT NOT NULL REFERENCES household_member(id),
    location_id TEXT REFERENCES household_location(id),
    made_at INTEGER NOT NULL,
    revision_id TEXT REFERENCES record_revision(id)
);

insertHousehold:
INSERT OR IGNORE INTO household(id, name, created_at) VALUES (?, ?, ?);

insertMember:
INSERT OR IGNORE INTO household_member(id, household_id, display_name, created_at) VALUES (?, ?, ?, ?);

insertLocation:
INSERT OR IGNORE INTO household_location(id, household_id, name, created_at) VALUES (?, ?, ?, ?);

selectFirstHousehold:
SELECT id, name, created_at FROM household ORDER BY created_at LIMIT 1;

selectFirstMember:
SELECT id, household_id, display_name FROM household_member WHERE household_id = ? LIMIT 1;

selectMembers:
SELECT id, display_name FROM household_member WHERE household_id = ? ORDER BY created_at, display_name COLLATE NOCASE;

selectLocations:
SELECT id, name FROM household_location ORDER BY name COLLATE NOCASE;

selectPreferredHome:
SELECT preference_value FROM local_preference WHERE preference_key = 'selected_home';

setPreferredHome:
INSERT OR REPLACE INTO local_preference(preference_key, preference_value) VALUES ('selected_home', ?);

selectPreferredMember:
SELECT preference_value FROM local_preference WHERE preference_key = 'selected_member';

setPreferredMember:
INSERT OR REPLACE INTO local_preference(preference_key, preference_value) VALUES ('selected_member', ?);

selectLocalPreference:
SELECT preference_value FROM local_preference WHERE preference_key = ?;

setLocalPreference:
INSERT OR REPLACE INTO local_preference(preference_key, preference_value) VALUES (?, ?);

deleteLocalPreference:
DELETE FROM local_preference WHERE preference_key = ?;

insertIngredientIgnore:
INSERT OR IGNORE INTO ingredient(id, canonical_name, category, created_at) VALUES (?, ?, ?, ?);

selectInventoryId:
SELECT id FROM inventory_item WHERE location_id = ? AND ingredient_id = ? ORDER BY updated_at, id LIMIT 1;

selectInventoryForIngredient:
SELECT id, location_id, ingredient_id, product_id, level, updated_at, updated_by_member_id
FROM inventory_item WHERE location_id = ? AND ingredient_id = ? ORDER BY updated_at, id;

selectInventoryById:
SELECT id, location_id, ingredient_id, product_id, level, updated_at, updated_by_member_id
FROM inventory_item WHERE id = ?;

insertInventory:
INSERT INTO inventory_item(id, location_id, ingredient_id, product_id, level, updated_at, updated_by_member_id)
VALUES (?, ?, ?, ?, ?, ?, ?);

updateInventoryById:
UPDATE inventory_item SET product_id = ?, level = ?, updated_at = ?, updated_by_member_id = ? WHERE id = ?;

updateAllInventoryForIngredient:
UPDATE inventory_item SET level = ?, updated_at = ?, updated_by_member_id = ? WHERE location_id = ? AND ingredient_id = ?;

selectPantryForLocation:
SELECT inventory_item.id AS inventory_id, inventory_item.product_id, ingredient.id AS ingredient_id,
       ingredient.canonical_name, ingredient.category, ingredient_product.product_name,
       ingredient_product.brand, ingredient_product.barcode, inventory_item.level,
       ingredient_product.bottle_quantity, ingredient_product.abv_percent,
       COALESCE(ingredient_product.photo_data,
           (SELECT photo_data FROM ingredient_product WHERE ingredient_id = ingredient.id ORDER BY created_at LIMIT 1)
       ) AS photo_data
FROM inventory_item
JOIN ingredient ON ingredient.id = inventory_item.ingredient_id
LEFT JOIN ingredient_product ON ingredient_product.id = inventory_item.product_id
WHERE inventory_item.location_id = ?
ORDER BY ingredient.category COLLATE NOCASE, ingredient.canonical_name COLLATE NOCASE,
         ingredient_product.product_name COLLATE NOCASE, inventory_item.updated_at, inventory_item.id;

selectOpenBottleIntakeSession:
SELECT * FROM bottle_intake_session WHERE status = 'OPEN' ORDER BY updated_at DESC, id LIMIT 1;

selectBottleIntakeSession:
SELECT * FROM bottle_intake_session WHERE id = ?;

insertBottleIntakeSession:
INSERT INTO bottle_intake_session(id, status, location_id, default_level, created_at, updated_at, confirmed_count)
VALUES (?, 'OPEN', ?, ?, ?, ?, 0);

updateBottleIntakeSessionHome:
UPDATE bottle_intake_session SET location_id = ?, updated_at = ? WHERE id = ? AND status = 'OPEN';

updateBottleIntakeSessionDefaultLevel:
UPDATE bottle_intake_session SET default_level = ?, updated_at = ? WHERE id = ? AND status = 'OPEN';

incrementBottleIntakeAcceptedCount:
UPDATE bottle_intake_session SET confirmed_count = confirmed_count + 1, updated_at = ? WHERE id = ? AND status = 'OPEN';

confirmBottleIntakeSession:
UPDATE bottle_intake_session SET status = 'CONFIRMED', updated_at = ?, confirmed_count = ? WHERE id = ? AND status = 'OPEN';

selectBottleIntakeDrafts:
SELECT id, session_id, position, barcode, product_id, ingredient_name, category, brand, product_name,
       photo_data, photo_sha256, bottle_quantity, abv_percent, bottle_quantity_edited, abv_percent_edited, location_id, level, created_at
FROM bottle_intake_draft WHERE session_id = ? ORDER BY position, id;

selectBottleIntakeDraft:
SELECT * FROM bottle_intake_draft WHERE id = ? AND session_id = ?;

selectNextBottleIntakePosition:
SELECT COALESCE(MAX(position) + 1, 0) AS next_position FROM bottle_intake_draft WHERE session_id = ?;

insertBottleIntakeDraft:
INSERT INTO bottle_intake_draft(
    id, session_id, position, barcode, product_id, ingredient_name, category, brand, product_name,
    photo_data, photo_sha256, bottle_quantity, abv_percent, bottle_quantity_edited, abv_percent_edited, location_id, level, created_at
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

deleteBottleIntakeSession:
DELETE FROM bottle_intake_session WHERE id = ? AND status = 'OPEN';

updateBottleIntakeDraft:
UPDATE bottle_intake_draft SET barcode = ?, product_id = ?, ingredient_name = ?, category = ?, brand = ?,
    product_name = ?, photo_data = ?, photo_sha256 = ?, bottle_quantity = ?, abv_percent = ?,
    bottle_quantity_edited = ?, abv_percent_edited = ?, location_id = ?, level = ?
WHERE id = ? AND session_id = ?;

updateBottleIntakeDraftsHome:
UPDATE bottle_intake_draft SET location_id = ? WHERE session_id = ?;

updateBottleIntakeDraftsLevel:
UPDATE bottle_intake_draft SET level = ? WHERE session_id = ?;

deleteBottleIntakeDraft:
DELETE FROM bottle_intake_draft WHERE id = ? AND session_id = ?;

selectBottleIntakeAcceptance:
SELECT draft_id, session_id, inventory_id, accepted_at FROM bottle_intake_acceptance WHERE draft_id = ?;

insertBottleIntakeAcceptance:
INSERT INTO bottle_intake_acceptance(draft_id, session_id, inventory_id, accepted_at) VALUES (?, ?, ?, ?);

deleteBottleIntakeDrafts:
DELETE FROM bottle_intake_draft WHERE session_id = ?;

deleteConfirmedBottleIntakeSessions:
DELETE FROM bottle_intake_session WHERE status = 'CONFIRMED';

selectRecipeFamilies:
SELECT cocktail_family.id AS family_id, cocktail_family.canonical_name,
       COUNT(DISTINCT recipe_variant.id) AS variant_count
FROM cocktail_family
JOIN recipe_variant ON recipe_variant.family_id = cocktail_family.id
WHERE NOT EXISTS (
    SELECT 1 FROM tombstone
    WHERE tombstone.record_type = 'RECIPE_VARIANT' AND tombstone.record_id = recipe_variant.id
)
AND NOT EXISTS (
    SELECT 1 FROM tombstone
    WHERE tombstone.record_type = 'COCKTAIL_FAMILY' AND tombstone.record_id = cocktail_family.id
)
GROUP BY cocktail_family.id
HAVING COUNT(DISTINCT recipe_variant.id) > 0
ORDER BY cocktail_family.canonical_name COLLATE NOCASE;

findFamilyByName:
SELECT id FROM cocktail_family WHERE canonical_name = ? COLLATE NOCASE;

insertRecipeFamily:
INSERT INTO cocktail_family(id, canonical_name, created_at) VALUES (?, ?, ?);

insertRecipeVariant:
INSERT INTO recipe_variant(id, family_id, title, source_kind, instructions, preparation, servings, style, created_at)
VALUES (?, ?, ?, 'HOUSEHOLD', ?, ?, ?, ?, ?);

insertCatalogRecipeVariant:
INSERT INTO recipe_variant(id, family_id, title, source_kind, instructions, preparation, servings, style, created_at)
VALUES (?, ?, ?, 'CATALOG', ?, ?, ?, ?, ?);

updateRecipeVariantRevision:
UPDATE recipe_variant SET revision_id = ? WHERE id = ?;

insertRecipeIngredient:
INSERT INTO recipe_ingredient(id, variant_id, ingredient_id, amount_value, amount_unit, preparation, optional, sort_order)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

selectIngredientsByName:
SELECT id FROM ingredient WHERE canonical_name = ? COLLATE NOCASE
ORDER BY CASE WHEN category = 'Spirit' COLLATE NOCASE THEN 0 ELSE 1 END
LIMIT 1;

selectIngredientByNameAndCategory:
SELECT id FROM ingredient WHERE canonical_name = ? COLLATE NOCASE AND category = ? COLLATE NOCASE;

countIngredientsByName:
SELECT COUNT(*) FROM ingredient WHERE canonical_name = ? COLLATE NOCASE;

updateIngredientCategory:
UPDATE ingredient SET category = ? WHERE id = ?;

selectSpiritCandidates:
SELECT id, canonical_name FROM ingredient WHERE category = 'Spirit' COLLATE NOCASE ORDER BY canonical_name COLLATE NOCASE;

selectRecipeVariants:
SELECT recipe_variant.id AS variant_id, recipe_variant.family_id, recipe_variant.title,
       recipe_variant.instructions, recipe_variant.preparation, recipe_variant.servings, recipe_variant.style,
       recipe_variant.source_kind
FROM recipe_variant
WHERE NOT EXISTS (
    SELECT 1 FROM tombstone
    WHERE tombstone.record_type = 'RECIPE_VARIANT' AND tombstone.record_id = recipe_variant.id
)
AND NOT EXISTS (
    SELECT 1 FROM tombstone
    WHERE tombstone.record_type = 'COCKTAIL_FAMILY' AND tombstone.record_id = recipe_variant.family_id
)
ORDER BY recipe_variant.title COLLATE NOCASE;

selectRecipeIngredients:
SELECT ingredient.id AS ingredient_id, ingredient.canonical_name, recipe_ingredient.amount_value, recipe_ingredient.amount_unit,
       recipe_ingredient.preparation, recipe_ingredient.optional
FROM recipe_ingredient
JOIN ingredient ON ingredient.id = recipe_ingredient.ingredient_id
WHERE recipe_ingredient.variant_id = ?
ORDER BY recipe_ingredient.sort_order;

updateRecipeVariantDraft:
UPDATE recipe_variant SET title = ?, instructions = ?, servings = ?, style = ?, revision_id = ? WHERE id = ?;

updateRecipeVariantWithFamily:
UPDATE recipe_variant SET family_id = ?, title = ?, instructions = ?, servings = ?, style = ?, revision_id = ? WHERE id = ?;

selectRecipeSourcesForVariant:
SELECT id, source_name, source_record_id, source_url, license_name, attribution, modifications, imported_at
FROM recipe_source WHERE variant_id = ? ORDER BY imported_at, id;

selectRecipeSourceById:
SELECT id, variant_id, source_name, source_record_id, source_url, license_name, attribution, modifications, imported_at
FROM recipe_source WHERE id = ?;

updateRecipeSourceAssociation:
UPDATE recipe_source SET variant_id = ?, modifications = ? WHERE id = ?;

insertRecipeSource:
INSERT INTO recipe_source(id, variant_id, source_name, source_record_id, source_url, license_name, attribution, modifications, imported_at)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

selectFavorite:
SELECT created_at FROM favorite WHERE member_id = ? AND family_id = ?;

selectActiveFavoriteFamilies:
SELECT favorite.family_id FROM favorite
WHERE favorite.member_id = ? AND NOT EXISTS (
    SELECT 1 FROM tombstone
    WHERE tombstone.record_type = 'FAVORITE'
      AND tombstone.record_id = length(favorite.member_id) || '#' || favorite.member_id || length(favorite.family_id) || '#' || favorite.family_id
)
ORDER BY favorite.created_at DESC, favorite.family_id;

selectRecentlyMade:
SELECT drink_event.id, drink_event.variant_id, recipe_variant.title, household_member.display_name,
       drink_event.made_at, household_location.name AS location_name
FROM drink_event
JOIN recipe_variant ON recipe_variant.id = drink_event.variant_id
JOIN household_member ON household_member.id = drink_event.member_id
LEFT JOIN household_location ON household_location.id = drink_event.location_id
WHERE NOT EXISTS (
    SELECT 1 FROM tombstone
    WHERE tombstone.record_type = 'RECIPE_VARIANT' AND tombstone.record_id = recipe_variant.id
)
AND NOT EXISTS (
    SELECT 1 FROM tombstone
    WHERE tombstone.record_type = 'COCKTAIL_FAMILY' AND tombstone.record_id = recipe_variant.family_id
)
ORDER BY drink_event.made_at DESC, drink_event.id DESC
LIMIT ?;

insertTastingNote:
INSERT INTO tasting_note(id, variant_id, member_id, location_id, rating, note, created_at)
VALUES (?, ?, ?, ?, ?, ?, ?);

updateTastingNoteRevision:
UPDATE tasting_note SET revision_id = ? WHERE id = ?;

selectTastingNotes:
SELECT tasting_note.id, tasting_note.member_id, household_member.display_name,
       tasting_note.location_id, tasting_note.rating, tasting_note.note, tasting_note.created_at
FROM tasting_note
JOIN household_member ON household_member.id = tasting_note.member_id
WHERE tasting_note.variant_id = ?
ORDER BY tasting_note.created_at DESC;

selectLatestRecordRevision:
SELECT id FROM record_revision
WHERE record_id = ? AND record_type = ?
ORDER BY rowid DESC LIMIT 1;

insertRecordRevision:
INSERT INTO record_revision(id, record_id, record_type, author_member_id, device_id, created_at, schema_version, payload)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

insertRevisionParent:
INSERT OR IGNORE INTO revision_parent(revision_id, parent_revision_id) VALUES (?, ?);

selectRevisionPayload:
SELECT payload FROM record_revision WHERE id = ?;

selectRevisionParents:
SELECT parent_revision_id FROM revision_parent WHERE revision_id = ? ORDER BY parent_revision_id;

insertTombstone:
INSERT INTO tombstone(record_id, record_type, revision_id, deleted_at) VALUES (?, ?, ?, ?);

selectTombstone:
SELECT revision_id FROM tombstone WHERE record_id = ? AND record_type = ?;

selectAllHouseholdsForBundle:
SELECT id, name, created_at FROM household;

selectAllMembersForBundle:
SELECT id, household_id, display_name, created_at FROM household_member;

selectAllLocationsForBundle:
SELECT id, household_id, name, created_at FROM household_location;

selectAllIngredientsForBundle:
SELECT id, canonical_name, category, created_at FROM ingredient;

selectAllProductsForBundle:
SELECT id, ingredient_id, brand, product_name, barcode, photo_mime_type, photo_data, photo_sha256, bottle_quantity, abv_percent, created_at FROM ingredient_product;

selectAllProductSourcesForBundle:
SELECT id, product_id, retrieval_provider, extraction_provider, extraction_model, source_url,
       field_name, field_value, evidence_quote, license_name, created_at
FROM ingredient_product_source ORDER BY product_id, created_at, id;

selectProductSourcesForProduct:
SELECT id, product_id, retrieval_provider, extraction_provider, extraction_model, source_url,
       field_name, field_value, evidence_quote, license_name, created_at
FROM ingredient_product_source WHERE product_id = ? ORDER BY created_at, id;

selectProductForIngredient:
SELECT id, ingredient_id, brand, product_name, barcode, photo_mime_type, photo_data, photo_sha256, bottle_quantity, abv_percent, created_at
FROM ingredient_product WHERE ingredient_id = ? ORDER BY created_at LIMIT 1;

selectProductById:
SELECT id, ingredient_id, brand, product_name, barcode, photo_mime_type, photo_data, photo_sha256, bottle_quantity, abv_percent, created_at
FROM ingredient_product WHERE id = ?;

selectAllInventoryForBundle:
SELECT id, location_id, ingredient_id, product_id, level, updated_at, updated_by_member_id FROM inventory_item;

selectAllFamiliesForBundle:
SELECT id, canonical_name, created_at FROM cocktail_family;

selectAllAliasesForBundle:
SELECT family_id, alias FROM cocktail_alias ORDER BY family_id, alias;

selectAllVariantsForBundle:
SELECT id, family_id, title, source_kind, instructions, preparation, servings, style, revision_id, created_at FROM recipe_variant;

selectAllSourcesForBundle:
SELECT id, variant_id, source_name, source_record_id, source_url, license_name, attribution, modifications, imported_at FROM recipe_source;

selectAllRecipeIngredientsForBundle:
SELECT id, variant_id, ingredient_id, amount_value, amount_unit, preparation, optional, sort_order FROM recipe_ingredient;

selectAllNotesForBundle:
SELECT id, variant_id, member_id, location_id, rating, note, created_at, revision_id FROM tasting_note;

selectAllFavoritesForBundle:
SELECT member_id, family_id, created_at FROM favorite;

selectAllRevisionsForBundle:
SELECT id, record_id, record_type, author_member_id, device_id, created_at, schema_version, payload FROM record_revision ORDER BY rowid;

selectAllRevisionParentsForBundle:
SELECT revision_id, parent_revision_id FROM revision_parent;

selectAllTombstonesForBundle:
SELECT record_id, record_type, revision_id, deleted_at FROM tombstone;

selectRevisionHeads:
SELECT revision.id
FROM record_revision AS revision
WHERE revision.record_id = ? AND revision.record_type = ?
AND NOT EXISTS (SELECT 1 FROM revision_parent WHERE revision_parent.parent_revision_id = revision.id)
ORDER BY revision.id;

insertHouseholdIgnore:
INSERT OR IGNORE INTO household(id, name, created_at) VALUES (?, ?, ?);

updateHousehold:
UPDATE household SET name = ? WHERE id = ?;

insertMemberIgnore:
INSERT OR IGNORE INTO household_member(id, household_id, display_name, created_at) VALUES (?, ?, ?, ?);

updateMember:
UPDATE household_member SET household_id = ?, display_name = ? WHERE id = ?;

insertLocationIgnore:
INSERT OR IGNORE INTO household_location(id, household_id, name, created_at) VALUES (?, ?, ?, ?);

updateLocation:
UPDATE household_location SET household_id = ?, name = ? WHERE id = ?;

insertIngredientBundleIgnore:
INSERT OR IGNORE INTO ingredient(id, canonical_name, category, created_at) VALUES (?, ?, ?, ?);

updateIngredientBundle:
UPDATE ingredient SET canonical_name = ?, category = ? WHERE id = ?;

insertProductIgnore:
INSERT OR IGNORE INTO ingredient_product(id, ingredient_id, brand, product_name, barcode, created_at) VALUES (?, ?, ?, ?, ?, ?);

insertProductSourceIgnore:
INSERT OR IGNORE INTO ingredient_product_source(
    id, product_id, retrieval_provider, extraction_provider, extraction_model, source_url,
    field_name, field_value, evidence_quote, license_name, created_at
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

selectProductsForBarcodeDeduplication:
SELECT id, ingredient_id, brand, product_name, barcode, created_at
FROM ingredient_product
WHERE barcode IS NOT NULL;

selectProductsForBarcodeLookup:
SELECT ingredient_product.id AS product_id, ingredient.id AS ingredient_id,
       ingredient.canonical_name AS ingredient_name, ingredient.category, ingredient_product.brand,
       ingredient_product.product_name, ingredient_product.barcode,
       ingredient_product.bottle_quantity, ingredient_product.abv_percent
FROM ingredient_product
JOIN ingredient ON ingredient.id = ingredient_product.ingredient_id
WHERE ingredient_product.barcode IS NOT NULL;

updateProduct:
UPDATE ingredient_product SET ingredient_id = ?, brand = ?, product_name = ?, barcode = ? WHERE id = ?;

updateProductPhoto:
UPDATE ingredient_product SET photo_mime_type = ?, photo_data = ?, photo_sha256 = ? WHERE id = ?;

updateProductPackageFacts:
UPDATE ingredient_product SET bottle_quantity = ?, abv_percent = ? WHERE id = ?;

insertInventoryBundleIgnore:
INSERT OR IGNORE INTO inventory_item(id, location_id, ingredient_id, product_id, level, updated_at, updated_by_member_id) VALUES (?, ?, ?, ?, ?, ?, ?);

updateInventoryBundleById:
UPDATE inventory_item SET location_id = ?, ingredient_id = ?, product_id = ?, level = ?, updated_at = ?, updated_by_member_id = ? WHERE id = ?;

insertFamilyIgnore:
INSERT OR IGNORE INTO cocktail_family(id, canonical_name, created_at) VALUES (?, ?, ?);

updateFamily:
UPDATE cocktail_family SET canonical_name = ? WHERE id = ?;

deleteAliasesForFamily:
DELETE FROM cocktail_alias WHERE family_id = ?;

insertAliasIgnore:
INSERT OR IGNORE INTO cocktail_alias(family_id, alias) VALUES (?, ?);

insertRecipeVariantBundleIgnore:
INSERT OR IGNORE INTO recipe_variant(id, family_id, title, source_kind, instructions, preparation, servings, style, revision_id, created_at)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

updateRecipeVariantBundle:
UPDATE recipe_variant SET family_id = ?, title = ?, source_kind = ?, instructions = ?, preparation = ?, servings = ?, style = ?, revision_id = ? WHERE id = ?;

deleteRecipeIngredientsForVariant:
DELETE FROM recipe_ingredient WHERE variant_id = ?;

insertRecipeSourceIgnore:
INSERT OR IGNORE INTO recipe_source(id, variant_id, source_name, source_record_id, source_url, license_name, attribution, modifications, imported_at)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

updateRecipeSource:
UPDATE recipe_source SET variant_id = ?, source_name = ?, source_record_id = ?, source_url = ?, license_name = ?, attribution = ?, modifications = ?, imported_at = ? WHERE id = ?;

insertRecipeIngredientBundleIgnore:
INSERT INTO recipe_ingredient(id, variant_id, ingredient_id, amount_value, amount_unit, preparation, optional, sort_order)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

insertTastingNoteIgnore:
INSERT OR IGNORE INTO tasting_note(id, variant_id, member_id, location_id, rating, note, created_at, revision_id)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

updateTastingNote:
UPDATE tasting_note SET variant_id = ?, member_id = ?, location_id = ?, rating = ?, note = ?, created_at = ?, revision_id = ? WHERE id = ?;

insertFavoriteIgnore:
INSERT OR IGNORE INTO favorite(member_id, family_id, created_at) VALUES (?, ?, ?);

insertDrinkEvent:
INSERT INTO drink_event(id, variant_id, member_id, location_id, made_at, revision_id)
VALUES (?, ?, ?, ?, ?, ?);

updateDrinkEventRevision:
UPDATE drink_event SET revision_id = ? WHERE id = ?;

selectAllDrinkEventsForBundle:
SELECT id, variant_id, member_id, location_id, made_at, revision_id FROM drink_event;

insertDrinkEventBundleIgnore:
INSERT OR IGNORE INTO drink_event(id, variant_id, member_id, location_id, made_at, revision_id)
VALUES (?, ?, ?, ?, ?, ?);

updateDrinkEventBundle:
UPDATE drink_event SET variant_id = ?, member_id = ?, location_id = ?, made_at = ?, revision_id = ? WHERE id = ?;

updateFavorite:
UPDATE favorite SET created_at = ? WHERE member_id = ? AND family_id = ?;

insertRecordRevisionIgnore:
INSERT OR IGNORE INTO record_revision(id, record_id, record_type, author_member_id, device_id, created_at, schema_version, payload)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

updateRecordRevisionParentIgnore:
INSERT OR IGNORE INTO revision_parent(revision_id, parent_revision_id) VALUES (?, ?);

deleteTombstone:
DELETE FROM tombstone WHERE record_id = ?;

insertTombstoneBundle:
INSERT INTO tombstone(record_id, record_type, revision_id, deleted_at) VALUES (?, ?, ?, ?);

deleteAllRevisionParents:
DELETE FROM revision_parent;

deleteAllRecordRevisions:
DELETE FROM record_revision;

deleteAllLocations:
DELETE FROM household_location;

deleteAllMembers:
DELETE FROM household_member;

deleteAllHouseholds:
DELETE FROM household;

deleteSelectedHomeAndMemberPreferences:
DELETE FROM local_preference WHERE preference_key IN ('selected_home', 'selected_member');

deleteTombstoneRevision:
DELETE FROM tombstone WHERE record_id = ?;
