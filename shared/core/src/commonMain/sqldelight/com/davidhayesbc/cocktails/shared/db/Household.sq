insertDrinkEvent:
INSERT INTO drink_event(id, variant_id, member_id, location_id, made_at, revision_id)
VALUES (?, ?, ?, ?, ?, ?);

updateDrinkEventRevision:
UPDATE drink_event SET revision_id = ? WHERE id = ?;

selectAllDrinkEventsForBundle:
SELECT id, variant_id, member_id, location_id, made_at, revision_id FROM drink_event;

insertDrinkEventBundleIgnore:
INSERT OR IGNORE INTO drink_event(id, variant_id, member_id, location_id, made_at, revision_id)
VALUES (?, ?, ?, ?, ?, ?);

updateDrinkEventBundle:
UPDATE drink_event SET variant_id = ?, member_id = ?, location_id = ?, made_at = ?, revision_id = ? WHERE id = ?;

