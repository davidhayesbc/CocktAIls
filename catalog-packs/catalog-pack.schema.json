{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CocktAIls attributed offline catalog pack",
  "type": "object",
  "required": [
    "format",
    "id",
    "version",
    "sourceName",
    "license",
    "licenseUrl",
    "attribution",
    "repositoryRevision",
    "recipes"
  ],
  "properties": {
    "format": {
      "enum": [
        "cocktails.catalog-pack.v1",
        "cocktails.catalog-pack.v2"
      ]
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "sourceKind": {
      "type": "string"
    },
    "sourceName": {
      "type": "string",
      "minLength": 1
    },
    "license": {
      "type": "string",
      "minLength": 1
    },
    "licenseUrl": {
      "type": "string",
      "pattern": "^https://"
    },
    "licenseNotice": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "attribution": {
      "type": "string",
      "minLength": 1
    },
    "repositoryUrl": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^https://"
    },
    "repositoryRevision": {
      "type": "string",
      "minLength": 1
    },
    "recipes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/recipe"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "sourceKind": {
            "const": "UPLOADED_DATA"
          }
        },
        "required": [
          "sourceKind"
        ]
      },
      "then": {
        "required": [
          "licenseNotice"
        ],
        "properties": {
          "format": {
            "const": "cocktails.catalog-pack.v2"
          },
          "recipes": {
            "items": {
              "required": [
                "sourceMetadata"
              ],
              "properties": {
                "ingredients": {
                  "items": {
                    "properties": {
                      "amount": {
                        "type": "null"
                      }
                    }
                  }
                },
                "sourceMetadata": {
                  "required": [
                    "rawQuantities",
                    "originalRecord"
                  ],
                  "properties": {
                    "rawQuantities": {
                      "const": true
                    },
                    "originalRecord": {
                      "type": "object",
                      "required": [
                        "id"
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      },
      "else": {
        "required": [
          "repositoryUrl"
        ],
        "properties": {
          "repositoryUrl": {
            "type": "string",
            "pattern": "^https://"
          },
          "recipes": {
            "items": {
              "required": [
                "permanentUrl",
                "historyUrl"
              ],
              "properties": {
                "permanentUrl": {
                  "type": "string",
                  "pattern": "^https://"
                },
                "historyUrl": {
                  "type": "string",
                  "pattern": "^https://"
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "recipe": {
      "type": "object",
      "required": [
        "recordId",
        "title",
        "style",
        "servings",
        "instructions",
        "modifications",
        "originalIngredients",
        "ingredients"
      ],
      "properties": {
        "recordId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "style": {
          "enum": [
            "OTHER",
            "SHORT",
            "LONG",
            "SOUR",
            "BITTER",
            "SWEET",
            "HOT",
            "COLD"
          ]
        },
        "servings": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "instructions": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "permanentUrl": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^https://"
        },
        "historyUrl": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^https://"
        },
        "modifications": {
          "type": "string",
          "minLength": 1
        },
        "originalIngredients": {
          "type": "string",
          "minLength": 1
        },
        "familyAliases": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          }
        },
        "sourceMetadata": {
          "type": "object"
        },
        "ingredients": {
          "type": "array",
          "minItems": 1,
          "maxItems": 40,
          "items": {
            "$ref": "#/$defs/ingredient"
          }
        }
      }
    },
    "ingredient": {
      "type": "object",
      "required": [
        "name",
        "category"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "category": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "amount": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "unit": {
          "type": [
            "string",
            "null"
          ]
        },
        "preparation": {
          "type": [
            "string",
            "null"
          ]
        },
        "optional": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "amount": {
                "type": "number"
              }
            },
            "required": [
              "amount"
            ]
          },
          "then": {
            "required": [
              "unit"
            ],
            "properties": {
              "unit": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    }
  }
}
